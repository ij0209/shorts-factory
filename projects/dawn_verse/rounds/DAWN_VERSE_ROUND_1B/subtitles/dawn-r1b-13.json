[
  {
    "type": "hook",
    "text": "아무렇지 않은 척했지만",
    "start": 0.7,
    "end": 3.06
  },
  {
    "type": "hook",
    "text": "빈자리가 유난히 큰 아침인가요?",
    "start": 3.06,
    "end": 6.4
  },
  {
    "type": "verse",
    "text": "여호와는 마음이 상한 자에게 가까이 하시고",
    "start": 6.4,
    "end": 10.92
  },
  {
    "type": "reflection",
    "text": "슬픔은 믿음이 부족하다는 증거가 아닙니다.",
    "start": 10.92,
    "end": 15.44
  },
  {
    "type": "reflection",
    "text": "사랑했던 만큼 빈자리가 아픈 것은 당연합니다.",
    "start": 15.44,
    "end": 20.35
  },
  {
    "type": "reflection",
    "text": "하나님은 빨리 괜찮아지라고 멀리서 재촉하지 않으시고,",
    "start": 20.35,
    "end": 26.04
  },
  {
    "type": "reflection",
    "text": "상한 마음 가까이에 계신다고 말씀하십니다.",
    "start": 26.04,
    "end": 30.56
  },
  {
    "type": "reflection",
    "text": "오늘 눈물이 나면 참지 않아도 됩니다.",
    "start": 30.56,
    "end": 34.69
  },
  {
    "type": "reflection",
    "text": "그 사람을 기억하고, 믿을 만한 이에게 마음을 말하며,",
    "start": 34.69,
    "end": 40.58
  },
  {
    "type": "reflection",
    "text": "하루에 필요한 만큼만 걸어가세요.",
    "start": 40.58,
    "end": 44.12
  },
  {
    "type": "reflection",
    "text": "애도에도 시간이 필요합니다.",
    "start": 44.12,
    "end": 47.07
  },
  {
    "type": "prayer",
    "text": "하나님, 말로 다 설명할 수 없는 그리움 곁에 머물러 주세요.",
    "start": 47.07,
    "end": 53.75
  },
  {
    "type": "prayer",
    "text": "제 눈물을 부끄러워하지 않게 하시고,",
    "start": 53.75,
    "end": 57.68
  },
  {
    "type": "prayer",
    "text": "기억 속 사랑을 품으며 오늘을 견딜 힘을 주세요.",
    "start": 57.68,
    "end": 62.98
  },
  {
    "type": "prayer",
    "text": "슬픔 속에서도 혼자가 아님을 알게 해주세요.",
    "start": 62.98,
    "end": 67.7
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 68.6,
    "end": 68.98
  },
  {
    "type": "cta",
    "text": "오늘 떠오르는 고마운 기억 하나를 조용히 간직해 보세요.",
    "start": 70.18,
    "end": 75.51
  }
]