[
  {
    "type": "hook",
    "text": "숨길수록 마음이 더 무거워지는 일이 있나요?",
    "start": 0.7,
    "end": 5.35
  },
  {
    "type": "verse",
    "text": "만일 우리가 우리 죄를 자백하면",
    "start": 5.35,
    "end": 8.64
  },
  {
    "type": "reflection",
    "text": "고백은 잘못을 작게 만드는 말이 아닙니다.",
    "start": 8.64,
    "end": 13.09
  },
  {
    "type": "reflection",
    "text": "내가 한 일을 정확히 인정하고",
    "start": 13.09,
    "end": 16.18
  },
  {
    "type": "reflection",
    "text": "하나님 앞에서 빛으로 나오는 용기입니다.",
    "start": 16.18,
    "end": 20.44
  },
  {
    "type": "reflection",
    "text": "용서는 책임을 피하는 핑계도 아닙니다.",
    "start": 20.44,
    "end": 24.51
  },
  {
    "type": "reflection",
    "text": "사과해야 할 사람이 있다면 변명 없이 사과하고,",
    "start": 24.51,
    "end": 29.54
  },
  {
    "type": "reflection",
    "text": "돌려놓아야 할 것이 있다면 가능한 방법을 찾으세요.",
    "start": 29.54,
    "end": 34.96
  },
  {
    "type": "reflection",
    "text": "혼자 감당하기 어렵다면",
    "start": 34.96,
    "end": 37.28
  },
  {
    "type": "reflection",
    "text": "신뢰할 수 있는 목회자나 상담자에게 도움을 구하세요.",
    "start": 37.28,
    "end": 42.9
  },
  {
    "type": "reflection",
    "text": "회복은 정직한 한 걸음에서 시작됩니다.",
    "start": 42.9,
    "end": 46.96
  },
  {
    "type": "prayer",
    "text": "하나님, 잘못을 숨기고 싶은 두려움을 이기게 해주세요.",
    "start": 46.96,
    "end": 52.77
  },
  {
    "type": "prayer",
    "text": "제 죄를 정직하게 고백하고",
    "start": 52.77,
    "end": 55.48
  },
  {
    "type": "prayer",
    "text": "필요한 책임을 피하지 않게 해주세요.",
    "start": 55.48,
    "end": 59.35
  },
  {
    "type": "prayer",
    "text": "용서의 은혜 안에서 같은 잘못을",
    "start": 59.35,
    "end": 62.64
  },
  {
    "type": "prayer",
    "text": "반복하지 않는 새 길을 걷게 해주세요.",
    "start": 62.64,
    "end": 66.7
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 67.6,
    "end": 67.97
  },
  {
    "type": "cta",
    "text": "오늘 하나님 앞에서 숨김없이 한 가지를 고백해 보세요.",
    "start": 69.17,
    "end": 74.33
  }
]