[
  {
    "type": "hook",
    "text": "오래 기도했는데 아무것도 달라지지 않은 것 같나요?",
    "start": 0.7,
    "end": 5.77
  },
  {
    "type": "verse",
    "text": "강하고 담대하며 여호와를 바랄지어다",
    "start": 5.77,
    "end": 9.21
  },
  {
    "type": "reflection",
    "text": "기다린다는 것은 아무 일도 하지 않는 시간이 아닙니다.",
    "start": 9.21,
    "end": 14.65
  },
  {
    "type": "reflection",
    "text": "답이 보이지 않을 때에도 마음이 무너지지 않도록",
    "start": 14.65,
    "end": 19.36
  },
  {
    "type": "reflection",
    "text": "오늘 해야 할 순종을 이어가는 일입니다.",
    "start": 19.36,
    "end": 23.34
  },
  {
    "type": "reflection",
    "text": "응답의 모양과 때를 내가 정해두면",
    "start": 23.34,
    "end": 26.6
  },
  {
    "type": "reflection",
    "text": "침묵처럼 느껴질 수 있습니다.",
    "start": 26.6,
    "end": 29.5
  },
  {
    "type": "reflection",
    "text": "기도한 뒤 살펴야 할 현실이 있다면 살피고,",
    "start": 29.5,
    "end": 33.85
  },
  {
    "type": "reflection",
    "text": "만나야 할 사람이 있다면 만나세요.",
    "start": 33.85,
    "end": 37.29
  },
  {
    "type": "reflection",
    "text": "기다림 속에서도 하나님은 우리를 더 깊고 단단하게 빚으십니다.",
    "start": 37.29,
    "end": 43.45
  },
  {
    "type": "prayer",
    "text": "하나님, 늦어지는 시간 속에서 낙심하지 않게 해주세요.",
    "start": 43.45,
    "end": 48.88
  },
  {
    "type": "prayer",
    "text": "제가 정한 답만 고집하지 않고",
    "start": 48.88,
    "end": 51.78
  },
  {
    "type": "prayer",
    "text": "주님의 인도를 분별하게 해주세요.",
    "start": 51.78,
    "end": 55.04
  },
  {
    "type": "prayer",
    "text": "오늘 할 수 있는 순종을 놓치지 않는 담대함을 주세요.",
    "start": 55.04,
    "end": 60.47
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 61.37,
    "end": 61.68
  }
]