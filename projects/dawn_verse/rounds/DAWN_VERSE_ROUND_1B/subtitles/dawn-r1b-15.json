[
  {
    "type": "hook",
    "text": "오래 기도했는데 아무것도 달라지지 않은 것 같나요?",
    "start": 0.7,
    "end": 5.71
  },
  {
    "type": "verse",
    "text": "강하고 담대하며 여호와를 바랄지어다",
    "start": 5.71,
    "end": 9.11
  },
  {
    "type": "reflection",
    "text": "기다린다는 것은 아무 일도 하지 않는 시간이 아닙니다.",
    "start": 9.11,
    "end": 14.48
  },
  {
    "type": "reflection",
    "text": "답이 보이지 않을 때에도 마음이 무너지지 않도록 오늘 해야 할 순종을 이어가는 일입니다.",
    "start": 14.48,
    "end": 23.25
  },
  {
    "type": "reflection",
    "text": "응답의 모양과 때를 내가 정해두면 침묵처럼 느껴질 수 있습니다.",
    "start": 23.25,
    "end": 29.51
  },
  {
    "type": "reflection",
    "text": "기도한 뒤 살펴야 할 현실이 있다면 살피고, 만나야 할 사람이 있다면 만나세요.",
    "start": 29.51,
    "end": 37.39
  },
  {
    "type": "reflection",
    "text": "기다림 속에서도 하나님은 우리를 더 깊고 단단하게 빚으십니다.",
    "start": 37.39,
    "end": 43.47
  },
  {
    "type": "prayer",
    "text": "하나님, 늦어지는 시간 속에서 낙심하지 않게 해주세요.",
    "start": 43.47,
    "end": 48.84
  },
  {
    "type": "prayer",
    "text": "제가 정한 답만 고집하지 않고 주님의 인도를 분별하게 해주세요.",
    "start": 48.84,
    "end": 55.11
  },
  {
    "type": "prayer",
    "text": "오늘 할 수 있는 순종을 놓치지 않는 담대함을 주세요.",
    "start": 55.11,
    "end": 60.47
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 61.37,
    "end": 61.68
  }
]