[
  {
    "type": "hook",
    "text": "어젯밤 다툰 사람과 오늘도 마주해야 하나요?",
    "start": 0.7,
    "end": 5.42
  },
  {
    "type": "verse",
    "text": "유순한 대답은 분노를 쉬게 하여도 과격한 말은 노를 격동하느니라",
    "start": 5.42,
    "end": 12.29
  },
  {
    "type": "reflection",
    "text": "부드럽게 말하는 것은 잘못을 모른 척하는 일이 아닙니다.",
    "start": 12.29,
    "end": 18.39
  },
  {
    "type": "reflection",
    "text": "같은 진실도 어떤 마음으로 건네느냐에 따라 관계를 살리기도 하고 더 깊이 다치게도 합니다.",
    "start": 18.39,
    "end": 28.21
  },
  {
    "type": "reflection",
    "text": "오늘 먼저 해야 할 말은 긴 설명이 아닐 수 있습니다.",
    "start": 28.21,
    "end": 34.11
  },
  {
    "type": "reflection",
    "text": "어제 내 말이 거칠었다고, 당신의 마음을 다시 듣고 싶다고 짧게 시작해 보세요.",
    "start": 34.11,
    "end": 42.75
  },
  {
    "type": "reflection",
    "text": "이기려는 마음이 내려갈 때 대화가 다시 열립니다.",
    "start": 42.75,
    "end": 48.06
  },
  {
    "type": "prayer",
    "text": "하나님, 내 옳음만 붙들었던 마음을 내려놓게 해주세요.",
    "start": 48.06,
    "end": 53.95
  },
  {
    "type": "prayer",
    "text": "상처를 키우는 말 대신 관계를 살리는 첫마디를 고르게 해주세요.",
    "start": 53.95,
    "end": 60.83
  },
  {
    "type": "prayer",
    "text": "상대의 마음을 끝까지 들을 수 있는 온유함을 주세요.",
    "start": 60.83,
    "end": 66.53
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 67.43,
    "end": 67.83
  },
  {
    "type": "cta",
    "text": "오늘 내가 먼저 건넬 한마디를 마음에 적어보세요.",
    "start": 69.03,
    "end": 73.85
  }
]