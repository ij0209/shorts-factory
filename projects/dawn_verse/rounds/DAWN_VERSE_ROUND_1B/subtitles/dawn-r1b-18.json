[
  {
    "type": "hook",
    "text": "밤새 뒤척이다 무거운 몸으로 아침을 맞았나요?",
    "start": 0.7,
    "end": 5.97
  },
  {
    "type": "verse",
    "text": "내가 평안히 눕고 자기도 하리니",
    "start": 5.97,
    "end": 9.55
  },
  {
    "type": "reflection",
    "text": "잠을 이루지 못한 밤에는 작은 걱정도 훨씬 크게 들립니다.",
    "start": 9.55,
    "end": 16.3
  },
  {
    "type": "reflection",
    "text": "오늘의 피곤함을 의지의 부족으로 몰아붙이지 마세요.",
    "start": 16.3,
    "end": 22.2
  },
  {
    "type": "reflection",
    "text": "시편의 고백처럼 안전을 하나님께 맡기고,",
    "start": 22.2,
    "end": 26.84
  },
  {
    "type": "reflection",
    "text": "몸이 보내는 신호도 정직하게 돌보아야 합니다.",
    "start": 26.84,
    "end": 32.11
  },
  {
    "type": "reflection",
    "text": "가능한 일정을 조금 줄이고 햇빛을 보고 천천히 움직이세요.",
    "start": 32.11,
    "end": 38.86
  },
  {
    "type": "reflection",
    "text": "불면이 오래 이어지거나 일상을 무너뜨린다면",
    "start": 38.86,
    "end": 43.7
  },
  {
    "type": "reflection",
    "text": "전문적인 도움을 받는 것도 지혜로운 선택입니다.",
    "start": 43.7,
    "end": 49.19
  },
  {
    "type": "prayer",
    "text": "하나님, 밤새 깨어 있던 몸과 마음을 불쌍히 여겨 주세요.",
    "start": 49.19,
    "end": 55.93
  },
  {
    "type": "prayer",
    "text": "통제할 수 없는 걱정을 주님께 맡기고",
    "start": 55.93,
    "end": 60.15
  },
  {
    "type": "prayer",
    "text": "오늘 필요한 쉼을 허락하게 해주세요.",
    "start": 60.15,
    "end": 64.36
  },
  {
    "type": "prayer",
    "text": "제 몸을 지혜롭게 돌보며 다시 평안히 눕게 해주세요.",
    "start": 64.36,
    "end": 70.48
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 71.38,
    "end": 71.79
  },
  {
    "type": "cta",
    "text": "오늘은 할 일을 하나 덜어내고 몸에 작은 쉼을 주세요.",
    "start": 72.99,
    "end": 78.24
  }
]