[
  {
    "type": "hook",
    "text": "애썼는데 결과가 보이지 않나요?",
    "start": 0.7,
    "end": 4.67
  },
  {
    "type": "verse",
    "text": "너희 수고가 주 안에서 헛되지 않은 줄을 앎이니라",
    "start": 4.67,
    "end": 10.97
  },
  {
    "type": "reflection",
    "text": "말씀은 모든 일이 성공한다고 약속하지 않습니다.",
    "start": 10.97,
    "end": 17.04
  },
  {
    "type": "reflection",
    "text": "다만 주 안에서 한 수고의 가치를 지워 버리지 않습니다.",
    "start": 17.04,
    "end": 24.28
  },
  {
    "type": "prayer",
    "text": "하나님, 결과만으로 저를 판단하지 않게 해주세요. 다시 성실할 힘을 주세요.",
    "start": 24.28,
    "end": 34.08
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 34.98,
    "end": 35.18
  }
]