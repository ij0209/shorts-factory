    "end": 17.96
  },
  {
    "type": "reflection",
    "text": "오늘 한 사람에게 먼저 안부를 건네보세요.",
    "start": 17.96,
    "end": 23.25
  },
  {
    "type": "prayer",
    "text": "하나님, 적막한 마음을 아시지요.",
