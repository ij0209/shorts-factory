    "end": 8.75
  },
  {
    "type": "reflection",
    "text": "사람의 소식이 없는 아침에도 하나님",
    "start": 8.75,
    "end": 13.13
  },
  {
    "type": "reflection",
    "text": "앞에서 당신은 사라진 사람이 아닙니다.",
