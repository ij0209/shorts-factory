[
  {
    "type": "hook",
    "text": "오늘 꼭 결정을 내려야 한다면.",
    "start": 0.7,
    "end": 4.28
  },
  {
    "type": "verse",
    "text": "지혜가 부족하거든 모든 사람에게 후히 주시고",
    "start": 4.28,
    "end": 9.33
  },
  {
    "type": "verse",
    "text": "꾸짖지 아니하시는 하나님께 구하라",
    "start": 9.33,
    "end": 13.11
  },
  {
    "type": "reflection",
    "text": "확신이 없는 자신을 탓하지 마세요.",
    "start": 13.11,
    "end": 17.11
  },
  {
    "type": "reflection",
    "text": "조건을 살피고 조언을 들으며",
    "start": 17.11,
    "end": 20.27
  },
  {
    "type": "reflection",
    "text": "지혜를 구할 수 있습니다.",
    "start": 20.27,
    "end": 23.21
  },
  {
    "type": "prayer",
    "text": "하나님, 조급함보다 분별력을 주세요.",
    "start": 23.21,
    "end": 27.42
  },
  {
    "type": "prayer",
    "text": "두려움에 끌리지 않고 결정하게 해주세요.",
    "start": 27.42,
    "end": 32.05
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 32.95,
    "end": 33.29
  }
]