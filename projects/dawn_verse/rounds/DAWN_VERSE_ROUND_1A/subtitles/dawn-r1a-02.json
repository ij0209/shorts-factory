[
  {
    "type": "hook",
    "text": "자녀의 선택 때문에 밤을 설쳤다면.",
    "start": 0.7,
    "end": 4.55
  },
  {
    "type": "verse",
    "text": "자식은 여호와의 주신 기업이요",
