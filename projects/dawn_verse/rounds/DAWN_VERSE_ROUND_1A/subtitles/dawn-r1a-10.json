[
  {
    "type": "hook",
    "text": "실패한 뒤의 첫 아침이라면.",
    "start": 0.7,
    "end": 3.55
  },
  {
    "type": "verse",
    "text": "이것이 아침마다 새로우니 주의 성실이 크도소이다",
    "start": 3.55,
    "end": 8.49
  },
  {
    "type": "reflection",
    "text": "이 말씀은 고난이 없다고 말하지 않습니다.",
    "start": 8.49,
    "end": 12.86
  },
  {
    "type": "reflection",
    "text": "무너진 자리에서도 자비를 기억하며 오늘을 다시 열 수 있습니다.",
    "start": 12.86,
    "end": 19.51
  },
  {
    "type": "prayer",
    "text": "하나님, 어제의 실패에 저를 가두지 말아 주세요. 오늘 시작할 작은 일을 보여주세요.",
    "start": 19.51,
    "end": 28.44
  },
  {
    "type": "amen",
    "text": "아멘.",
    "start": 29.34,
    "end": 29.72
  }
