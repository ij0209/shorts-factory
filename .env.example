WEMAKEVOICE_API_URL=
WEMAKEVOICE_API_KEY=
DEFAULT_VOICE=Aoede
DEFAULT_SPEED=10
KEEP_TEMP_FILES=false
KEEP_REMOTION_ASSETS=false
USE_LOCAL_TTS=false
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_CONTENT_MODEL=gemini-3.6-flash
ENABLE_BRAND_SIGNATURE=true
BRAND_SIGNATURE_VOICE=Algenib

# YouTube Data API v3 OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback
# 채널별 Channel ID (UC로 시작). OAuth token은 .env가 아니라 전용 파일에 자동 저장됩니다.
WEMAKEVOICE_YOUTUBE_CHANNEL_ID=
LIFE_MARGIN_YOUTUBE_CHANNEL_ID=
WEMAKEVOICE_YOUTUBE_AUTO_UPLOAD=false
LIFE_MARGIN_YOUTUBE_AUTO_UPLOAD=false
WEMAKEVOICE_YOUTUBE_PUBLISH_HOUR=19
WEMAKEVOICE_YOUTUBE_PUBLISH_MINUTE=0
LIFE_MARGIN_YOUTUBE_PUBLISH_HOUR=20
LIFE_MARGIN_YOUTUBE_PUBLISH_MINUTE=30
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_TIMEZONE=Asia/Seoul
YOUTUBE_CATEGORY_ID=27
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_LIKE_RATE_MIN_VIEWS=100
DAWN_VERSE_YOUTUBE_CHANNEL_ID=
DAWN_VERSE_YOUTUBE_AUTO_UPLOAD=false
DAWN_VERSE_YOUTUBE_PUBLISH_HOUR=5
DAWN_VERSE_YOUTUBE_PUBLISH_MINUTE=0
